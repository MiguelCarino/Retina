<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements. The first three are the minimum Electron needs
  for V8. Library validation is deliberately NOT disabled: this app bundles no
  dylibs of its own, so that entitlement would only widen the attack surface for
  nothing. (The Carino PACS build does disable it, because it ships a PyInstaller
  engine with its own libraries.)

  device.camera is Retina's own addition and has no counterpart in the two
  sibling shells: index.html:2470-2489 calls getUserMedia and enumerateDevices to
  capture a fundus image. It must be paired with NSCameraUsageDescription in
  build.mac.extendInfo — without BOTH, camera capture fails on a signed macOS
  build, and it fails by returning no device rather than by raising anything.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key><true/>
  <key>com.apple.security.device.camera</key><true/>
</dict>
</plist>
